# ── Google Gemini AI (FREE — Recommended for browser features) ────────────────
# Free tier: 15 req/min · 1M tokens/day — no credit card needed!
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXX

# ── Anthropic (Claude AI) — Optional, used by CLI automation only ─────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXX

# ── Gmail (for sending application emails) ───────────────────────────────────
# Use a Gmail App Password (NOT your regular password).
# Enable 2FA first, then create App Password at:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Naukri.com credentials ───────────────────────────────────────────────────
NAUKRI_EMAIL=youremail@gmail.com
NAUKRI_PASSWORD=your_naukri_password

# ── Internshala credentials ──────────────────────────────────────────────────
INTERNSHALA_EMAIL=youremail@gmail.com
INTERNSHALA_PASSWORD=your_internshala_password

# ── LinkedIn credentials ─────────────────────────────────────────────────────
LINKEDIN_EMAIL=youremail@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── Automation settings ───────────────────────────────────────────────────────
# "true" = browser window hidden, "false" = watch what's happening
# (use false for the first LinkedIn runs so you can solve any 2FA/CAPTCHA)
HEADLESS=true
# Max Easy Apply submissions per run (safety limit)
DAILY_APPLY_LIMIT=5
# Gap between outbound emails, in ms — minimum enforced is 10000 (10s) so Gmail
# doesn't flag the burst. Raise it if you send large batches.
EMAIL_SEND_GAP_MS=10000

# ── LinkedIn auto-apply / referral settings ──────────────────────────────────
# How many colleagues to contact per company when --referrals is on
REFERRALS_PER_JOB=2
# Corporate email guess pattern for referral contacts when no public email:
#   first.last | firstlast | flast | first
COMPANY_EMAIL_PATTERN=first.last
