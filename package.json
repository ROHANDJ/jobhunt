{
  "name": "jobhunt-pro",
  "version": "2.0.0",
  "description": "Automated job hunting platform for freshers — resume analysis, form-filling, scheduled email campaigns",
  "type": "module",
  "main": "automation/runner.js",
  "scripts": {
    "setup":    "node automation/setup.js",
    "run":      "node automation/runner.js run",
