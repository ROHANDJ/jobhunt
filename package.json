{
  "name": "locked-in",
  "version": "2.0.0",
  "description": "Locked In — careers + MS abroad HQ for freshers: job auto-apply, resume AI, and a full higher-studies hub (universities, scholarships, exams, SOP/visa tips)",
  "type": "module",
  "main": "automation/runner.js",
  "scripts": {
    "setup": "node automation/setup.js",
    "run": "node automation/runner.js run",
    "analyze": "node automation/runner.js analyze",
    "email": "node automation/runner.js email",
    "fill": "node automation/runner.js fill",
    "scrape-hr": "node automation/runner.js scrape-hr",
    "linkedin": "node automation/runner.js linkedin",
    "linkedin:auto": "node automation/runner.js linkedin --auto --referrals",
    "schedule": "node automation/runner.js schedule",
    "status": "node automation/runner.js status",
    "mail-server": "node automation/mail-server.js",
    "serve": "npx serve . -p 3000",
    "dev": "concurrently \"npm run mail-server\" \"npm run serve\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.45.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
